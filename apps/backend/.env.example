# =============================================================================
# Knowledge Engine — Backend Environment Variables Template
# Copy this file to .env.development (or .env) and customize for your environment.
# NEVER commit real credentials and .env or production secrets to source control.
# =============================================================================

# ── Application Configuration ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=*
WEB_URL=http://localhost:3000

# ── PostgreSQL with pgvector ─────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_NAME=frogtoberfest
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

# ── Redis (BullMQ Queues & Caching) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── pgAdmin (Docker Dev Environment) ─────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ── Swappable Vector Embedding Provider (Adapter Pattern) ────────────────────
# Supported providers: 'ollama' (local container/CPU) | 'remote-gpu' (OpenAI/vLLM)
EMBEDDING_PROVIDER=ollama

# Option A: Local Ollama Settings (used when EMBEDDING_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768

# Option B: Remote GPU / OpenAI / vLLM Settings (used when EMBEDDING_PROVIDER=remote-gpu)
# REMOTE_GPU_URL=http://localhost:8000
# REMOTE_GPU_API_KEY=your-api-key-here
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536

# ── OpenTelemetry & Tracing (Jaeger) ─────────────────────────────────────────
OTEL_ATTR_SERVICE_NAME=Knowledge_Engine
OTEL_ATTR_SERVICE_VERSION=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATIO=1.0