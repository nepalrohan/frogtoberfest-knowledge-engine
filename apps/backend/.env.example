# =============================================================================
# Knowledge Engine — Backend Environment Variables
# Copy this file to .env.development (or .env) and fill in your values.
# NEVER commit .env files with real credentials to version control.
# =============================================================================

# ── App ──────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=*
WEB_URL=http://localhost:3000

# ── PostgreSQL (pgvector) ────────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_NAME=frogtoberfest
DATABASE_SSL=false
DATABASE_SYNCHRONIZE=true

# ── Redis (BullMQ) ──────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── pgAdmin (Docker only) ──────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ── Embedding Provider ──────────────────────────────────────────────────────
EMBEDDING_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
# REMOTE_GPU_URL=http://localhost:8000
# REMOTE_GPU_API_KEY=

# ── OpenTelemetry ───────────────────────────────────────────────────────────
OTEL_ATTR_SERVICE_NAME=Knowledge_Engine
OTEL_ATTR_SERVICE_VERSION=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATIO=1