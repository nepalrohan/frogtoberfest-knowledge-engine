# =============================================================================
# Knowledge Engine — Backend Environment Variables Template
# Copy this file to .env.development (or .env) and customize for your environment.
# NEVER commit real credentials and .env or production secrets to source control.
# =============================================================================

# ── Application Configuration ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
APP_VERSION=1.0.0
CORS_ORIGIN=*
WEB_URL=http://localhost:3000

# ── PostgreSQL with pgvector ─────────────────────────────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgrespassword
DATABASE_NAME=frogtoberfest
DATABASE_SSL=false
# Schema is managed by migrations (run automatically on startup); keep false
DATABASE_SYNCHRONIZE=false

# ── Redis (BullMQ Queues & Caching) ──────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ── pgAdmin (Docker Dev Environment) ─────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin123

# ── Swappable Vector Embedding Provider (Adapter Pattern) ────────────────────
# Supported providers: 'ollama' (local container/CPU) | 'remote-gpu' (OpenAI/vLLM)
EMBEDDING_PROVIDER=ollama

# Option A: Local Ollama Settings (used when EMBEDDING_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
# Must equal the document_chunk.embedding column width (vector(768)); the app refuses to start otherwise.
# Switching to a model with another width needs a new migration and a full re-embed.
EMBEDDING_DIMENSION=768

# Option B: Remote GPU / OpenAI / vLLM Settings (used when EMBEDDING_PROVIDER=remote-gpu)
# Serve the same 768-d model (e.g. nomic-embed-text via vLLM) so stored vectors stay comparable.
# REMOTE_GPU_URL=http://localhost:8000
# REMOTE_GPU_API_KEY=your-api-key-here
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIMENSION=768

# ── Answer Generation (local Ollama chat model) ──────────────────────────────
# LLM_BASE_URL=http://localhost:11434   # defaults to OLLAMA_URL
GENERATION_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.1
LLM_NUM_CTX=8192
# Abort generation when no token arrives for this long
LLM_IDLE_TIMEOUT_MS=30000
# Follow-up rewriting falls back to the original question after this long
LLM_REWRITE_TIMEOUT_MS=8000
# Tokens of LLM_NUM_CTX kept free for the answer; history, then sources, are trimmed to fit the rest
LLM_ANSWER_RESERVE_TOKENS=768
# Keeps the chat model loaded between questions so it is not reloaded from disk
LLM_KEEP_ALIVE=30m

# ── Retrieval ────────────────────────────────────────────────────────────────
# Refuse with "insufficient evidence" when the best cosine similarity is below this
RETRIEVAL_MIN_SIMILARITY=0.65
# ...unless a chunk contains at least this share of the question's terms (exact identifiers, error codes)
RETRIEVAL_MIN_KEYWORD_COVERAGE=0.8
RETRIEVAL_CANDIDATE_K=20
RETRIEVAL_MAX_SOURCES=5
RETRIEVAL_MAX_SOURCES_PER_DOCUMENT=2
RETRIEVAL_CONTEXT_TOKEN_BUDGET=2500

# ── Reranking (optional) ─────────────────────────────────────────────────────
# Cross-encoder service (Text Embeddings Inference). Start it with:
#   docker compose -f docker-compose.dev.yaml --profile reranker up -d reranker
# Leave empty to skip reranking.
# RERANKER_URL=http://localhost:8081
# Model served by the compose "reranker" service (default cross-encoder/ms-marco-MiniLM-L-6-v2)
# RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_TIMEOUT_MS=10000

# ── Chat ─────────────────────────────────────────────────────────────────────
# Reuse the answer to an identical first question for this long (0 disables)
CHAT_ANSWER_CACHE_TTL_SECONDS=3600

# ── OpenTelemetry & Tracing (Jaeger) ─────────────────────────────────────────
OTEL_ATTR_SERVICE_NAME=Knowledge_Engine
OTEL_ATTR_SERVICE_VERSION=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SAMPLING_RATIO=1.0